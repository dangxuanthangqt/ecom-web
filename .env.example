# Template cho FE. Copy sang `.env.local` rồi sửa nếu cần:
#   cp .env.example .env.local
# Giá trị mặc định dưới đây khớp với backend `../ecom` chạy `pnpm start:dev`
# (PORT=4000 trong `.env.development`).

# Cổng của NestJS. KHÔNG có tiền tố NEXT_PUBLIC_ là cố ý: chỉ server component
# và route proxy đọc biến này, browser gọi `/api/proxy/*` cùng origin nên không
# bao giờ thấy URL thật của API. Mặc định trong code là http://localhost:4000.
API_URL=http://localhost:4000

# Origin của chính FE. Phải khớp `GOOGLE_REDIRECT_CLIENT_URI` bên Nest
# (http://localhost:3000/oauth/google — không có tiền tố locale, middleware
# next-intl tự thêm) và `app.enableCors({ origin })` trong `../ecom/src/main.ts`,
# nếu không login Google quay về sai chỗ.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- e2e (Playwright) — chỉ cần khi chạy `pnpm test:e2e` với backend thật.
# Bỏ trống thì playwright.config.ts tự dựng mock API và dùng cổng mặc định.
# E2E_BASE_URL=http://localhost:3000
# E2E_API_URL=http://localhost:4000
# E2E_APP_PORT=3000
# MOCK_API_PORT=4010
